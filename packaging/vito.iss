; Inno Setup script for Vito.
;
; Built by packaging/build-installer.ps1, which passes the version in:
;   iscc /DAppVersion=2026.7 packaging\vito.iss
;
; Design notes
; ------------
; * Per-user install (PrivilegesRequired=lowest, into {localappdata}\Programs).
;   No UAC prompt, which is what makes an unattended update actually unattended:
;   a per-machine install would ask for elevation every time.
; * Settings, history and recordings live in %APPDATA%\vito and %LOCALAPPDATA%\vito,
;   outside the install directory, so an upgrade never touches them and an
;   uninstall only removes them if you say so.
; * A running Vito holds its own .exe open, so PrepareToInstall asks it to quit
;   first — gracefully, via its own API, rather than killing the process.

#ifndef AppVersion
  #define AppVersion "0.0.0-dev"
#endif
; Windows' own version resource has to be four numbers, which "2026.7" is not —
; the build script passes the padded form alongside the one people read.
#ifndef VerInfo
  #define VerInfo "0.0.0.0"
#endif

#define AppName "Vito"
; The shortcut that launches the background daemon/tray is named separately, so
; it is clearly distinct from the "Open the Vito interface" shortcut and the
; installed-as-app PWA — all three would otherwise read simply "Vito".
#define AppTrayName "Vito Tray"
#define AppPublisher "Vincent Blok"
#define AppURL "https://github.com/vinceecniv/vito"
#define AppExe "vito.exe"

[Setup]
; Never change AppId: it is what ties an update to the existing installation.
AppId={{7E4D2C6A-1F3B-4A58-9C0E-6B2D8F1A5C93}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
VersionInfoVersion={#VerInfo}
AppPublisher={#AppPublisher}
AppPublisherURL={#AppURL}
AppSupportURL={#AppURL}
AppUpdatesURL={#AppURL}/releases
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
DisableDirPage=auto
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
OutputDir=..\dist
OutputBaseFilename=Vito-Setup-{#AppVersion}
SetupIconFile=vito.ico
UninstallDisplayIcon={app}\{#AppExe}
UninstallDisplayName={#AppName}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
; Vito-branded wizard art (generated by packaging/mkwizard.py): the coral→violet
; gradient panel with the mark and wordmark on the Welcome/Finished pages, and the
; mark alone top-right on the inner pages.
WizardImageFile=wizard-large.bmp
WizardSmallImageFile=wizard-small.bmp
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
; Shown on the welcome page; keep it short, the wizard is narrow.
AppComments=Voice In, Text Out
CloseApplications=no
RestartApplications=no

[Languages]
; English first: it is the fallback for any CustomMessage a language lacks.
Name: "en"; MessagesFile: "compiler:Default.isl"
Name: "nl"; MessagesFile: "compiler:Languages\Dutch.isl"
Name: "de"; MessagesFile: "compiler:Languages\German.isl"
Name: "fr"; MessagesFile: "compiler:Languages\French.isl"
Name: "es"; MessagesFile: "compiler:Languages\Spanish.isl"
Name: "it"; MessagesFile: "compiler:Languages\Italian.isl"
Name: "pt"; MessagesFile: "compiler:Languages\Portuguese.isl"
Name: "pl"; MessagesFile: "compiler:Languages\Polish.isl"
Name: "ru"; MessagesFile: "compiler:Languages\Russian.isl"
Name: "ja"; MessagesFile: "compiler:Languages\Japanese.isl"

