[Tasks]
Name: "desktopicon"; Description: "{cm:TaskDesktop}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "autostart";   Description: "{cm:TaskAutostart}"

[Files]
Source: "..\dist\{#AppExe}"; DestDir: "{app}"; Flags: ignoreversion
Source: "vito.ico";          DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\{#AppTrayName}";                Filename: "{app}\{#AppExe}"; Parameters: "serve"; IconFilename: "{app}\vito.ico"; Comment: "{cm:AppTagline}"
Name: "{group}\{cm:OpenUI}";                   Filename: "http://127.0.0.1:4573/"; IconFilename: "{app}\vito.ico"
Name: "{autodesktop}\{#AppTrayName}";          Filename: "{app}\{#AppExe}"; Parameters: "serve"; IconFilename: "{app}\vito.ico"; Tasks: desktopicon

[Run]
; Autostart is the app's own business — it rewrites the login-startup entry at
; every start so it always points at itself. Rather than seed a raw registry
; value here (which risks differing, byte for byte, from what the app writes and
; then failing to launch), we let Vito set it through its own code path. Runs
; before `serve` so the daemon's self-repair already sees it enabled.
Filename: "{app}\{#AppExe}"; Parameters: "autostart on"; Flags: runhidden; Tasks: autostart
; No skipifsilent here: an unattended update must bring Vito back up by itself.
Filename: "{app}\{#AppExe}"; Parameters: "serve"; Description: "{cm:RunVito}"; Flags: nowait postinstall
Filename: "http://127.0.0.1:4573/"; Description: "{cm:OpenUI}"; Flags: shellexec nowait postinstall skipifsilent

[UninstallRun]
; Stop the daemon before its files disappear underneath it.
Filename: "{app}\{#AppExe}"; Parameters: "quit"; Flags: runhidden; RunOnceId: "QuitVito"
; Remove the login-startup entry through the app itself (mirrors "autostart on"),
; so nothing is left pointing at the deleted executable.
Filename: "{app}\{#AppExe}"; Parameters: "autostart off"; Flags: runhidden; RunOnceId: "AutostartOff"

[Code]
function VitoRunning(): Boolean;
var
  ResultCode: Integer;
begin
  // `vito status` returns a non-zero exit code when nothing answers the port.
  Result := Exec(ExpandConstant('{app}\{#AppExe}'), 'status', '', SW_HIDE,
                 ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
end;

// PrepareToInstall runs before any file is replaced. Only an already-installed
// Vito is asked to quit — a copy running from somewhere else (a development
// build, say) is none of the installer's business.
function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  ResultCode, WaitedMs: Integer;
begin
  Result := '';
  if not FileExists(ExpandConstant('{app}\{#AppExe}')) then
    Exit;
  if not VitoRunning() then
    Exit;

  Exec(ExpandConstant('{app}\{#AppExe}'), 'quit', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  WaitedMs := 0;
  while (WaitedMs < 8000) and VitoRunning() do
  begin
    Sleep(250);
    WaitedMs := WaitedMs + 250;
  end;
  if VitoRunning() then
    Result := CustomMessage('QuitFailed');
end;

// On uninstall, ask before removing anything of the user's own. Silent
// uninstalls take the default, which is to keep it: losing your API keys,
// dictionary and history to an unattended update would be unforgivable.
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep <> usPostUninstall then
    Exit;
  if SuppressibleMsgBox(CustomMessage('RemoveDataDesc'), mbConfirmation,
                        MB_YESNO or MB_DEFBUTTON2, IDNO) = IDYES then
  begin
    DelTree(ExpandConstant('{userappdata}\vito'), True, True, True);
    DelTree(ExpandConstant('{localappdata}\vito'), True, True, True);
  end;
end;
